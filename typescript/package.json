{
  "name": "quiddity",
  "version": "0.1.0",
  "description": "Stable, configurable digests that capture the essence of values.",
  "keywords": [
    "digest",
    "hash",
    "canonical",
    "content-addressing",
    "etag"
  ],
  "license": "MIT",
  "author": "Luke Peterson <luketpeterson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/univalent-cc/quiddity.git",
    "directory": "typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p test/tsconfig.json",
    "test": "npm run build && npm run typecheck && node --test test/*.test.ts",
    "test:temporal": "npm run build && node --harmony-temporal test/temporal.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
